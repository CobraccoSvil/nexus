# Nexus Phase 0 — Environment Configuration Example

# Profile selection
NEXUS_PROFILE=cloud                    # cloud | hybrid | onprem

# Database (Postgres + pgvector)
POSTGRES_URL=postgres://nexus:nexus@localhost:5432/nexus
POSTGRES_SSL=false

# Cache (Redis)
REDIS_URL=redis://localhost:6379

# Observability
OTLP_ENDPOINT=http://localhost:4318    # OpenTelemetry Collector
LANGFUSE_HOST=http://localhost:3000    # Optional, Phase 5+
LANGFUSE_SECRET_KEY=test-secret

# Cloud Providers (Phase 1+)
ANTHROPIC_API_KEY=sk-ant-...           # https://console.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com

OPENAI_API_KEY=sk-...                  # https://platform.openai.com
OPENAI_BASE_URL=https://api.openai.com/v1

MISTRAL_API_KEY=...                    # https://console.mistral.ai
MISTRAL_BASE_URL=https://api.mistral.ai/v1

# vLLM Local (Phase 4+ / Hybrid / OnPrem)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=                          # Leave empty for local testing
VLLM_MODEL_NAME=Qwen/Qwen2.5-Coder-32B-Instruct

# PII Redaction (Phase 2+)
PRESIDIO_GRPC_URL=localhost:50051

# Configuration files
NEXUS_LLM_POLICY_FILE=./config/policies/default.yaml
NEXUS_MODEL_ALIASES_FILE=./config/model-aliases.yaml

# Encryption (Phase 6+)
KMS_PROVIDER=local                     # local | aws | vault
KMS_KEY_ARN=                            # AWS only

# Feature flags
NEXUS_ALLOW_CLOUD_TIER2=true
NEXUS_ALLOW_CLOUD_TIER3=false
NEXUS_REDACTION_STRICT=false
NEXUS_DLP_ENABLED=true

# Logging
LOG_LEVEL=info                         # debug | info | warn | error
NODE_ENV=development                   # development | production
