        {
          "expr": "nexus_resource_violations_open",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "table",
      "title": "Violazioni totali per classe/azione/esito",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 15 },
