{
  "name": "ai-orchestrator-v2",
  "private": true,
  "packageManager": "pnpm@10.7.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --check .",
    "verify": "bash scripts/verify.sh",
    "smoke": "bash scripts/smoke-services.sh",
    "e2e:debug-chat": "node scripts/debug-console-agent-e2e.mjs",
    "eval:prompts:smoke": "python3 evals/prompts/smoke_runner.py",
    "xtask": "cargo run -p xtask --",
    "prepare": "lefthook install || true",
    "test:nexus-suite": "bash scripts/run-nexus-suite.sh",
    "test:contract": "cargo test -p mcp-core --tests",
    "test:e2e": "python3 tests/e2e/nexus-suite/run_all.py",
    "test:maturity": "python3 tests/nexus-maturity/v2/run_rubric.py",
    "test:ui-e2e": "playwright test --config=apps/web-ide/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "@typescript-eslint/parser": "^8.46.1",
    "eslint": "^9.24.0",
    "lefthook": "^1.7.0",
    "prettier": "^3.5.3",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3"
  }
}
