[Unit]
Description=IDEAI Nexus LLM Gateway — Node.js (:4060)
After=network.target postgresql.service redis.service nexus-core.service

[Service]
Type=simple
User=administrator
WorkingDirectory=/opt/ideai
EnvironmentFile=/opt/ideai/.env
ExecStart=/usr/bin/node apps/nexus-gateway/dist/server.js
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/ideai/nexus-gateway.log
StandardError=append:/var/log/ideai/nexus-gateway.log

[Install]
WantedBy=multi-user.target
