# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_orchestrator
SHADOW_POSTGRES_URL=postgres://postgres:postgres@localhost:5433/ai_orchestrator_shadow

# Redis
REDIS_URL=redis://localhost:6379

# Vector DB
QDRANT_URL=http://localhost:6334

# Services — Core
MCP_SERVER_PORT=4000
NEURAL_CORE_URL=http://127.0.0.1:50051
WEB_APP_PORT=3000

# Services — Microservices
ADMIN_SERVICE_PORT=4010
CHAT_SERVICE_PORT=4020
DOC_SERVICE_PORT=4030
BILLING_SERVICE_PORT=4040
PLUGIN_SERVICE_PORT=4050

# Inter-service URLs (used by microservices to call each other)
CORE_SERVICE_URL=http://127.0.0.1:4000
BILLING_SERVICE_URL=http://127.0.0.1:4040
PLUGIN_SERVICE_URL=http://127.0.0.1:4050

# Auth
JWT_SECRET=change-me

# AI Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Nuovi provider (opzionale — gestibili anche via admin UI)
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Logging
RUST_LOG=info

# LangGraph Agent (opzionale — valori default automatici)
# I database SQLite vengono creati automaticamente in brain/nexus_memory/
# LANGGRAPH_DB_PATH=brain/nexus_memory/langgraph.db
# LEARNING_DB_PATH=brain/nexus_memory/learning.db
