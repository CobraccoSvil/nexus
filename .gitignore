brain/nexus_memory/
.claude/projects/
.cursor/
check_tables.txt
devnull
test-results/

# Run di test maturity Nexus: solo telemetria per debug locale, non utile in git.
# I template (collect.sh, monitor.sh, report-template.md, rubric.md) restano tracked.
tests/nexus-maturity/202[5-9]-*/


# Modelli ML scaricati via scripts/fetch-models.sh (troppo grandi per git)
models/minilm/

