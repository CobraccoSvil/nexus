{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 0,
  "panels": [
    {
      "type": "stat",
      "title": "Violazioni aperte (pannello Problemi)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(nexus_resource_violations_open)",
          "legendFormat": "aperte",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Riparazioni automatiche (esiti)",
      "gridPos": { "h": 6, "w": 10, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "nexus_resource_remediations_total",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Porte allocate (registro Nexus)",
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "targets": [
        {
          "expr": "nexus_port_allocations_total",
          "legendFormat": "allocazioni",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Violazioni nel tempo (rate 1h) per azione",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
