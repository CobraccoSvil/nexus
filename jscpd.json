{
  "$schema": "https://raw.githubusercontent.com/kucherenko/jscpd/master/packages/jscpd/schema.json",
  "minLines": 15,
  "minTokens": 100,
  "reporters": ["console", "json"],
  "output": "./.dup-report",
  "absolute": true,
  "gitignore": true,
  "format": ["typescript", "tsx", "javascript", "jsx", "rust"],
  "path": ["apps", "packages", "crates"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/.next/**",
    "**/.turbo/**",
    "**/target/**",
    "**/*.d.ts",
    "**/*.backup*",
    "**/*.gen.*",
    "**/generated/**",
    "**/proto/**",
    "db/migrations/**",
    "recovery/**",
    ".git/**",
    "deploy/grafana/**",
    "deploy/dashboards/**",
    "**/*.pb.rs",
    "**/page.tsx.backup*",
    "tests/**",
    "**/tests/**",
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.test.js",
    "**/*.test.jsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.spec.js",
    "**/*.spec.jsx"
  ]
}
