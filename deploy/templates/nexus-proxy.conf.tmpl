# Template nginx per il proxy esterno (PROXY_HOST = .03).
# Renderizzato da deploy/reload-proxy.sh: ${PROD_HOST} sostituito via envsubst.
# Destinazione: /etc/nginx/sites-available/nexus su PROXY_HOST.
#
# Topologia: Internet -> 443 (TLS) su PROXY_HOST -> 80 (HTTP) su PROD_HOST.
# Tutto il routing fine-grained ai microservizi e' delegato all'nginx interno
# su PROD_HOST (vedi deploy/nginx-microservices.conf).

upstream nexus_app {
    server ${PROD_HOST}:80;
    keepalive 32;
}

server {
    listen 80;
    server_name nexus.cobracco.it;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name nexus.cobracco.it;

    # TLS - i certificati sono gia' presenti e gestiti dall'esistente certbot
    ssl_certificate     /etc/letsencrypt/live/nexus.cobracco.it/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/nexus.cobracco.it/privkey.pem;

    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # Limiti upload (richiesti per upload documenti / immagini al chat)
    client_max_body_size 50m;

    # Timeouts allungati per SSE / agent streaming
    proxy_connect_timeout 10s;
    proxy_send_timeout    300s;
    proxy_read_timeout    300s;
    proxy_http_version    1.1;

    # Header propagati al backend
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;

    # Route SSE: disabilita buffering per streaming token in tempo reale
    location /api/chat/ {
        proxy_pass http://nexus_app;
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
    }

    # Route default: pass-through totale verso PROD_HOST con upgrade WebSocket
    location / {
        proxy_pass http://nexus_app;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Access log dedicato (separato da quello di default)
    access_log /var/log/nginx/nexus.access.log;
    error_log  /var/log/nginx/nexus.error.log;
}
