[Unit]
Description=IDEAI Neural Core — Python Brain (gRPC :50051 + REST :8001)
After=network.target

[Service]
Type=simple
User=administrator
WorkingDirectory=/opt/ideai
EnvironmentFile=/opt/ideai/.env
ExecStart=/opt/ideai/.venv/bin/python3 -m brain.grpc_server.main --rest
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/ideai/neural.log
StandardError=append:/var/log/ideai/neural.log

[Install]
WantedBy=multi-user.target
