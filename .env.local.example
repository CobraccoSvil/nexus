# Sviluppo locale WSL — copia in .env e personalizza
# Tutto gira in locale via docker-compose.local.yml (postgres incluso).

# ── Database (locale Docker) ──────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_orchestrator
SHADOW_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/ai_orchestrator_shadow
POSTGRES_URL=postgres://nexus:nexus@localhost:5433/nexus

# ── Servizi locali Docker ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6334
OTLP_ENDPOINT=http://localhost:4318

# ── Nexus LLM Gateway ────────────────────────────────────────────────────────
NEXUS_PROFILE=cloud
NEXUS_LLM_POLICY_FILE=./config/policies/default.yaml
NEXUS_MODEL_ALIASES_FILE=./config/model-aliases.yaml
NEXUS_DLP_ENABLED=true
NEXUS_ALLOW_CLOUD_TIER2=true
NEXUS_ALLOW_CLOUD_TIER3=false

# ── Porte microservizi ────────────────────────────────────────────────────────
MCP_SERVER_PORT=4000
ADMIN_SERVICE_PORT=4010
CHAT_SERVICE_PORT=4020
DOC_SERVICE_PORT=4030
BILLING_SERVICE_PORT=4040
PLUGIN_SERVICE_PORT=4050
WEB_APP_PORT=3000

# ── URL inter-servizi ─────────────────────────────────────────────────────────
NEURAL_CORE_URL=http://127.0.0.1:50051
CORE_SERVICE_URL=http://127.0.0.1:4000
BILLING_SERVICE_URL=http://127.0.0.1:4040
PLUGIN_SERVICE_URL=http://127.0.0.1:4050

# ── Auth ──────────────────────────────────────────────────────────────────────
# JWT secret condiviso tra tutti i servizi
JWT_SECRET=change-me-random-32chars-minimum

# ── AI Providers ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# ── Presidio (PII redaction) ──────────────────────────────────────────────────
PRESIDIO_GRPC_URL=localhost:50052

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info
LOG_LEVEL=debug
NODE_ENV=development

# ── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
