# nexus-brain.service — Neural Core di Nexus come unit systemd --SYSTEM.
#
# ADR 0028 livello 3 (2026-06-12): i servizi core di Nexus erano unit
# systemd --user, gestite dal manager user@<UID>. In WSL quel manager
# raggiunge `exit.target` e si spegne quando la sessione logind si chiude
# (chiusura terminale / errore WSL Relay vsock), NONOSTANTE `loginctl
# enable-linger`: porta giu' mcp-core e brain durante una chat. I container
# Docker (Postgres/Qdrant/Redis) non cadono MAI perche' girano come servizi
# --system gestiti da PID 1. Stessa scelta qui: PID 1 e' indipendente da
# logind/sessioni/linger, quindi il brain sopravvive alla caduta della
# sessione utente.
#
# Restart=always (non on-failure): quando la VM WSL viene sospesa/congelata
# (PC in sleep, instabilita' 9p) i processi ricevono SIGTERM dall'esterno e
# l'handler graceful esce con codice 0. systemd registra "Deactivated
# successfully" e con on-failure NON riavvia (exit 0 = successo) -> il servizio
# resta giu' al risveglio (freeze != reboot, quindi WantedBy non lo rilancia).
# always copre anche l'exit 0; i `systemctl stop/restart` espliciti del deploy
# restano rispettati (always non riavvia su stop comandato). StartLimit fa da
# safety net contro un crash-loop reale (config rotta): max 5 riavvii in 60s.
#
# Installata da deploy/install-system-units.sh (sostituisce __USER__/__UID__).

[Unit]
Description=Nexus Neural Core (brain Python) [system-level, ADR 0028 L3]
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=__USER__
Group=__USER__
WorkingDirectory=/home/__USER__/ideai
EnvironmentFile=-/home/__USER__/ideai/.env
Environment=HF_HUB_OFFLINE=1
Environment=TRANSFORMERS_OFFLINE=1
ExecStart=/usr/bin/python3 -m brain.grpc_server.main --rest
Restart=always
RestartSec=5
# Tetto memoria cgroup (rete di sicurezza, NON la causa del consumo normale).
# A regime il brain usa ~0.8 GB (modello embedding PyTorch + 55 thread BLAS);
# MemoryHigh=3G mette il kernel in reclaim aggressivo prima del limite, MemoryMax=4G
# e' il muro: oltre, l'OOM del cgroup uccide SOLO il brain (Restart=always lo
# riprende in 5s) invece di lasciar saturare la VM e congelarla. Contiene un
# eventuale leak o doppione SO_REUSEPORT senza piu' freeze dell'intera VM WSL.
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=4G
OOMPolicy=kill
StandardOutput=append:/tmp/nexus-neural.log
StandardError=append:/tmp/nexus-neural.log

[Install]
WantedBy=multi-user.target
