{
  "manifest_version": 3,
  "name": "Nexus Browser Bridge",
  "version": "0.1.1",
  "description": "Bridge fra Nexus (browser-bridge-mcp) e il browser dell'utente. Espone console, network e DOM via Chrome DevTools Protocol.",
  "permissions": ["debugger", "tabs", "storage", "activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Nexus Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "icons": {
    "128": "icon128.png"
  },
  "minimum_chrome_version": "116"
}
