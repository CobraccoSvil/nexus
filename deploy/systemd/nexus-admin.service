[Unit]
Description=IDEAI Admin Service (:4010)
After=network.target postgresql.service redis.service nexus-core.service

[Service]
Type=simple
User=administrator
WorkingDirectory=/opt/ideai
EnvironmentFile=/opt/ideai/.env
ExecStart=/opt/ideai/bin/admin-service
Restart=on-failure
RestartSec=5
StandardOutput=append:/var/log/ideai/admin.log
StandardError=append:/var/log/ideai/admin.log

[Install]
WantedBy=multi-user.target
